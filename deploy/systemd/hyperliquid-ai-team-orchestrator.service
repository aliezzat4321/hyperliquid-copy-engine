[Unit]
Description=Hyperliquid autonomous AI engineering team orchestrator
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/hyperliquid-ai-team/scripts/ai_team_orchestrator.py

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/hyperliquid-ai-team/scripts/ai_team_orchestrator.py --once
Nice=5
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
TimeoutStartSec=45min

# This root service is the only component with GitHub write authority.
# Model subprocesses are separately sandboxed as hl-codex-agent / hl-claude-agent.
