[Unit]
Description=Third-party wallet public trade research watcher
After=network-online.target hyperliquid-third-party-registry-sync.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/hyperliquid-copy-engine
EnvironmentFile=/root/hyperliquid-copy-engine/.env
Environment=REAL_TRADING_ENABLED=NO
ExecStart=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.shadow.wide_cli_live \
  --registry /var/lib/hyperliquid-copy-engine/third-party/wallets.json \
  --coins-file /mnt/HC_Volume_106576526/hyperliquid/shadow/active_perp_markets.txt \
  --output-dir /var/lib/hyperliquid-copy-engine/third-party/wide-trades \
  --max-live-lag-ms 2000
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/hyperliquid-copy-engine/third-party
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
