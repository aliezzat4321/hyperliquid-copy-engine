[Unit]
Description=Invo evidence to Hyperliquid wallet identifier
After=network-online.target
Wants=network-online.target
OnSuccess=hyperliquid-invo-verified-shadow-sync.service hyperliquid-third-party-registry-sync.service

[Service]
Type=oneshot
WorkingDirectory=/root/hyperliquid-copy-engine
Environment=REAL_TRADING_ENABLED=NO
ExecStart=/usr/bin/flock --wait 60 /run/hyperliquid-copy-engine/invo-pipeline.lock /root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.discovery.invo_identifier_durable_job --state-dir /var/lib/hyperliquid-copy-engine/invo --max-portfolios 8 --priority-trader carmine --priority-trader bones --priority-trader tyron --priority-trader rps --priority-trader tony64dss --priority-trader profitales --priority-trader limpan96 --priority-trader vortex_legion --unresolved-retry-minutes 60
User=root
Group=root
UMask=0077
TimeoutStartSec=50min
RuntimeDirectory=hyperliquid-copy-engine
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/hyperliquid-copy-engine
RestrictSUIDSGID=true
