[Unit]
Description=Read-only Invo trader source miner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/hyperliquid-copy-engine
EnvironmentFile=-/etc/hyperliquid-copy-engine/invo.env
ExecStart=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.discovery.invo_miner_job --state-dir /var/lib/hyperliquid-copy-engine/invo --portfolio-pages 5 --recent-feed-pages 3 --backfill-pages 10 --page-size 50
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths=/var/lib/hyperliquid-copy-engine /root/hyperliquid-copy-engine

[Install]
WantedBy=multi-user.target
