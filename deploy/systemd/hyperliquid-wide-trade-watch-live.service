[Unit]
Description=Hyperliquid prospective-only wide public trade watcher
After=network-online.target hyperliquid-shadow-validation.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/hyperliquid-copy-engine
EnvironmentFile=/root/hyperliquid-copy-engine/.env
Environment=REAL_TRADING_ENABLED=NO
ExecStart=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.shadow.wide_cli_live \
  --registry /mnt/HC_Volume_106576526/hyperliquid/shadow/wallets.json \
  --coins-file /mnt/HC_Volume_106576526/hyperliquid/shadow/active_perp_markets.txt \
  --output-dir /mnt/HC_Volume_106576526/hyperliquid/shadow/wide-trades-live \
  --max-live-lag-ms 2000
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
