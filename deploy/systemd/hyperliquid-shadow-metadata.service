[Unit]
Description=Hyperliquid shadow perp metadata snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/hyperliquid-copy-engine
EnvironmentFile=/root/hyperliquid-copy-engine/.env
Environment=REAL_TRADING_ENABLED=NO
ExecStart=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.shadow.metadata_cli \
  --output-dir /mnt/HC_Volume_106576526/hyperliquid/shadow/metadata
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
