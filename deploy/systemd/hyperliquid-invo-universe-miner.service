[Unit]
Description=Exhaustive read-only Invo universe miner
After=network-online.target
Wants=network-online.target
OnSuccess=hyperliquid-invo-wallet-identifier.service

[Service]
Type=oneshot
WorkingDirectory=/root/hyperliquid-copy-engine
EnvironmentFile=/etc/hyperliquid-copy-engine/invo.env
ExecStart=/usr/bin/flock --wait 3000 /run/hyperliquid-copy-engine/invo-pipeline.lock /root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.discovery.invo_universe_job --state-dir /var/lib/hyperliquid-copy-engine/invo --portfolio-pages 10 --feed-pages 6 --page-size 50
User=root
Group=root
UMask=0077
TimeoutStartSec=20min
RuntimeDirectory=hyperliquid-copy-engine
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/hyperliquid-copy-engine
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
