[Unit]
Description=Hyperliquid unified prospective follower profitability scorer
After=hyperliquid-shadow-validation.service hyperliquid-wide-trade-watch-live.service hyperliquid-wide-fill-enrichment-live.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/hyperliquid-copy-engine
EnvironmentFile=/root/hyperliquid-copy-engine/.env
Environment=REAL_TRADING_ENABLED=NO
ExecStart=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.profitability.causal_position_live_cli \
  --registry /mnt/HC_Volume_106576526/hyperliquid/shadow/wallets.json \
  --shadow-dir /mnt/HC_Volume_106576526/hyperliquid/shadow \
  --shadow-market-dir /mnt/HC_Volume_106576526/hyperliquid/market-shadow \
  --wide-enriched-dir /mnt/HC_Volume_106576526/hyperliquid/shadow/wide-enriched-live \
  --wide-cutoff-ns-file /mnt/HC_Volume_106576526/hyperliquid/shadow/wide_clean_cutoff_ns.txt \
  --wide-market-dir /mnt/HC_Volume_106576526/hyperliquid/market-shadow \
  --output-dir /mnt/HC_Volume_106576526/hyperliquid/profitability
ExecStartPost=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.profitability.ranking_cli \
  --input /mnt/HC_Volume_106576526/hyperliquid/profitability/master_profitability.json \
  --output-dir /mnt/HC_Volume_106576526/hyperliquid/profitability
ExecStartPost=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.profitability.leverage_cli \
  --input /mnt/HC_Volume_106576526/hyperliquid/profitability/master_profitability.json \
  --output /mnt/HC_Volume_106576526/hyperliquid/profitability/leverage_profitability.json
ExecStartPost=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.profitability.max_profitability_cli \
  --input /mnt/HC_Volume_106576526/hyperliquid/profitability/leverage_profitability.json \
  --output /mnt/HC_Volume_106576526/hyperliquid/profitability/max_profitability.json
ExecStartPost=/root/hyperliquid-copy-engine/.venv/bin/python -m hlcopy.profitability.attribution_cli \
  --input /mnt/HC_Volume_106576526/hyperliquid/profitability/master_profitability.json \
  --output /mnt/HC_Volume_106576526/hyperliquid/profitability/trade_attribution.json
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
