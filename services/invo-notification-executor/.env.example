# Existing Invo credential contract (normally supplied by /etc/hyperliquid-copy-engine/invo.env)
INVO_ACCESS_TOKEN=
INVO_REFRESH_TOKEN=

# Hyperliquid credentials are required only for LIVE execution.
# Shadow can run without a wallet and uses NOTIFICATION_TRADER_DRY_EQUITY_USD for sizing.
HL_AGENT_KEY=
WALLET_ADDRESS=

# Global kill switch used throughout hyperliquid-copy-engine.
REAL_TRADING_ENABLED=NO

# This service is shadow-only unless BOTH live flags are enabled.
NOTIFICATION_TRADER_LIVE=false

# Discovery stays broad, but dry Lane 3 NEW/ADD shadow exposure is admitted only for
# exact portfolioIds already classified ELITE_CANDIDATE before the source trade.
# Existing managed exposure may always close so demotion cannot orphan a position.
NOTIFICATION_TRADER_ALLOW=
NOTIFICATION_TRADER_COPY_ALL_FOLLOWED=true
NOTIFICATION_TRADER_FEED_FILTER=following
NOTIFICATION_TRADER_FEED_LIMIT=30
# Bound newest-to-high-water restart/poll backfill. An unreached cursor emits a gap.
NOTIFICATION_TRADER_FEED_MAX_PAGES=20
# Current web-app feed enum values. Every surface is baselined independently, so
# enabling a surface never replays historical OPEN/ADD events.
NOTIFICATION_TRADER_DISCOVERY_SURFACES=following,trending,fire_moves,most_recent
# Executor-owned bounded snapshot + compacted journal of portfolio evidence found on
# those feeds. This is not the candidate file and cannot itself authorize copying.
NOTIFICATION_TRADER_FEED_PORTFOLIO_EVIDENCE_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/feed-portfolio-evidence.json
# Read-only input used by the separate portfolio-research process.
INVO_FEED_PORTFOLIO_EVIDENCE_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/feed-portfolio-evidence.json
# Produced independently by the 10-minute portfolio/leaderboard research collector.
NOTIFICATION_TRADER_CANDIDATE_STATE_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/portfolio-candidates.json
# Immutable selector observations used for decision-time causal admission.
INVO_PORTFOLIO_CANDIDATE_SNAPSHOTS_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/portfolio-candidate-snapshots.jsonl
# Fail closed if the selector state is not refreshed within two collector cycles.
NOTIFICATION_TRADER_CANDIDATE_MAX_AGE_MS=1200000
# Shadow-only direct elite coverage runs independently of feed pagination. A target is
# WAITLISTED/ENROLLING until complete CLOSED and OPEN prospective baselines are durable.
# The compact admission index is the additional NEW/ADD authorization surface.
# Capacity is the minimum of this configured ceiling and a worst-case timeout x page
# bound within both poll deadlines after fixed executor overhead. With these defaults,
# one resident is provable (OPEN: 5s + 3 pages x 2 attempts x 2s = 17s). This is not a
# freshness guarantee under 429 cooldown; health exposes observed sweep lag and closes
# admission whenever resident count, lag, or cooldown makes the proof unhealthy.
NOTIFICATION_TRADER_DIRECT_WATCH_STATE_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/elite-direct-watch.json
NOTIFICATION_TRADER_DIRECT_WATCH_ADMISSION_INDEX_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/elite-direct-watch-admissions.json
INVO_HTTP_REQUEST_TIMEOUT_MS=2000
DIRECT_WATCH_FIXED_OVERHEAD_MS=5000
NOTIFICATION_TRADER_DIRECT_WATCH_SCAN_MS=3000
NOTIFICATION_TRADER_DIRECT_WATCH_MAX_HYDRATES_PER_SCAN=8
NOTIFICATION_TRADER_DIRECT_WATCH_OPEN_MAX_PAGES=3
NOTIFICATION_TRADER_DIRECT_WATCH_FALLBACK_POLL_MS=18000
NOTIFICATION_TRADER_DIRECT_WATCH_CLOSED_POLL_MS=60000
NOTIFICATION_TRADER_DIRECT_WATCH_MAX_CLOSED_HYDRATES_PER_SCAN=3
NOTIFICATION_TRADER_DIRECT_WATCH_CLOSED_MAX_PAGES=2
# ENROLLING + ACTIVE + MISSING_GRACE + RETIRING. Tombstones/waitlist consume no slots.
# This is a configured ceiling, not an admission promise; the computed proof may lower it.
MAX_DIRECT_WATCH_RESIDENT_TARGETS=48
# Only distinct, fresh, structurally valid explicit non-ELITE rows count. The grace is
# at least the current 10-minute candidate collector interval; bounded-page absence never counts.
DIRECT_WATCH_NEGATIVE_MIN_OBSERVATIONS=2
DIRECT_WATCH_NEGATIVE_GRACE_MS=600000

# Frozen, PnL-blind Lane 3 assessment-entry policy. Observation days are collection
# days, so historical posts returned at startup cannot instantly satisfy the window.
NOTIFICATION_TRADER_MIN_EVIDENCE_EVENTS=20
NOTIFICATION_TRADER_MIN_OBSERVATION_DAYS=7
NOTIFICATION_TRADER_STALE_AFTER_MS=259200000
NOTIFICATION_TRADER_INACTIVE_AFTER_MS=1209600000

# Research detection window. Source leverage is mirrored exactly up to Hyperliquid's
# actual asset maximum; there is no artificial NOTIFICATION_TRADER_MAX_LEVERAGE cap.
NOTIFICATION_TRADER_POLL_MS=1000
NOTIFICATION_TRADER_MAX_SIGNAL_AGE_MS=25000
NOTIFICATION_TRADER_MARGIN_PCT=1
NOTIFICATION_TRADER_DRY_EQUITY_USD=1000

# Lane 3 shadow execution-realism policy. Shadow fills walk the causal Hyperliquid
# l2Book, round to asset szDecimals, enforce minimum notional, and reject stale/wide
# books instead of inventing fills. Funding is read from Hyperliquid fundingHistory.
# Costs are never silently defaulted to zero in a COMPLETE profitability record.
# Canonical changeover: 750ms -> 1000ms, deploy run 34992024173,
# effective 2026-09-15T15:59:18Z, commit 90ee58d679a093c86543e09a6afc6e3238bc3a74.
NOTIFICATION_TRADER_SHADOW_MAX_BOOK_AGE_MS=1000
NOTIFICATION_TRADER_SHADOW_MAX_SPREAD_BPS=50
NOTIFICATION_TRADER_SHADOW_TAKER_FEE_BPS=4.5
NOTIFICATION_TRADER_SHADOW_FUNDING_ORACLE_MAX_DELAY_MS=10000
NOTIFICATION_TRADER_SHADOW_MIN_NOTIONAL_USD=10

# Live-account safety settings. These do NOT gate shadow research.
NOTIFICATION_TRADER_MAX_NOTIONAL_USD=500
NOTIFICATION_TRADER_MAX_SLIPPAGE_PCT=0.005
NOTIFICATION_TRADER_MAX_CHASE_BPS=25
NOTIFICATION_TRADER_MAX_POSITIONS=5

# Optional notification wake-up bridge. Keep loopback unless reverse-proxied securely.
NOTIFICATION_TRADER_HOST=127.0.0.1
NOTIFICATION_TRADER_PORT=8787
NOTIFICATION_BRIDGE_TOKEN=
NOTIFICATION_TRADER_PACKAGE_NAME=com.involio.app

NOTIFICATION_TRADER_STATE_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/state.json
NOTIFICATION_TRADER_AUDIT_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/audit.jsonl
NOTIFICATION_TRADER_TRACKER_PATH=/var/lib/hyperliquid-copy-engine/invo-notification-executor/trader-population.json
